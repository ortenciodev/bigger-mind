# Número do WhatsApp (apenas números, com DDI e DDD)
# Exemplo: 5511999999999 (55 = Brasil, 11 = SP, 999999999 = número)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Mensagem padrão enviada ao clicar no botão de WhatsApp
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Vim pelo site da BIGGER MIND e gostaria de saber mais sobre os serviços de desenvolvimento.

# Nome da empresa (exibido no site)
NEXT_PUBLIC_COMPANY_NAME=BIGGER MIND

# Email de contato
NEXT_PUBLIC_CONTACT_EMAIL=contato@biggermind.com.br

# URL do site em produção (para SEO)
NEXT_PUBLIC_SITE_URL=https://biggermind.com.br
